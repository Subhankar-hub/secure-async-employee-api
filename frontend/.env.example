VITE_CLIENT_ID=assessment_client
VITE_CLIENT_SECRET=

# Empty uses the Vite /api proxy (see DEV_API_PROXY).
# For a production build talking straight to EC2, set e.g. http://3.106.113.30:8080
VITE_API_BASE_URL=

# Used only by `npm run dev` (not baked into the browser bundle)
DEV_API_PROXY=http://localhost:8080
