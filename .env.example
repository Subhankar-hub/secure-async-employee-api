# Copy to .env (git-ignored), fill in values, then: set -a; source .env; set +a

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_SCHEMA=app_schema_dev
DB_USERNAME=app_user
DB_PASSWORD=

# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ISSUER=secure-async-employee-api

# BCrypt hashes of the client secrets (see README "Client credentials"), e.g. {bcrypt}$2a$12$...
ASSESSMENT_CLIENT_ID=assessment_client
ASSESSMENT_CLIENT_SECRET_HASH=
SECONDARY_CLIENT_ID=secondary_client
SECONDARY_CLIENT_SECRET_HASH=

# Schema used by integration tests (mvn verify)
TEST_DB_SCHEMA=app_schema_test
